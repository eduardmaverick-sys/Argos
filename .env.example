# ── AI Provider Configuration ─────────────────────────────────────────────────
#
# Set AI_PROVIDER to one of:
#   openai | anthropic | google | together | groq | cohere | mistral | openrouter
#
AI_PROVIDER=openai

# Your API key for the chosen provider
API_KEY=your_api_key_here

# (Optional) Specific model to use. Leave blank to use the default for your provider.
# Examples:
#   openai      → gpt-4o-mini, gpt-4o, gpt-4-turbo
#   anthropic   → claude-3-5-haiku-latest, claude-3-5-sonnet-latest
#   google      → gemini-1.5-flash, gemini-1.5-pro
#   together    → meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
#   groq        → llama-3.1-8b-instant, mixtral-8x7b-32768
#   cohere      → command-r-plus, command-r
#   mistral     → mistral-small-latest, mistral-large-latest
#   openrouter  → openai/gpt-4o-mini, anthropic/claude-3.5-haiku
AI_MODEL=

# ── Bot Tokens ────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token
DISCORD_TOKEN=your_discord_bot_token
